@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-5">
                        <div class="fs-1 mb-3">🐾</div>

                        <h1 class="fw-bold">Privacy Policy</h1>

                        <p class="text-muted">
                            Your privacy matters to us at PawCare.
                        </p>
                    </div>

                    @* Introduction *@
                    <section class="mb-4">
                        <h4 class="fw-semibold">1. Introduction</h4>

                        <p class="text-muted">
                            Welcome to PawCare, a veterinary clinic
                            management platform. This Privacy Policy
                            explains how we collect, use, and protect
                            your personal information.
                        </p>
                    </section>

                    @* Information We Collect *@
                    <section class="mb-4">
                        <h4 class="fw-semibold">
                            2. Information We Collect
                        </h4>

                        <p class="text-muted">
                            When using PawCare, you may provide:
                        </p>

                        <ul class="text-muted">
                            <li>Account information, such as email.</li>
                            <li>
                                Pet information, including name, species,
                                breed, gender, and birth date.
                            </li>
                            <li>Pet images or image URLs.</li>
                            <li>
                                Information needed to manage veterinary
                                services and appointments, where available.
                            </li>
                        </ul>
                    </section>

                    @* How We Use Information *@
                    <section class="mb-4">
                        <h4 class="fw-semibold">
                            3. How We Use Your Information
                        </h4>

                        <p class="text-muted">
                            We use information to provide and improve
                            PawCare services, manage user accounts,
                            maintain pet profiles, and support
                            veterinary care.
                        </p>
                    </section>

                    @* Data Security *@
                    <section class="mb-4">
                        <h4 class="fw-semibold">
                            4. Data Security
                        </h4>

                        <p class="text-muted">
                            We aim to protect personal information
                            through appropriate security measures,
                            including access controls and secure
                            application practices.
                        </p>
                    </section>

                    @* Data Sharing *@
                    <section class="mb-4">
                        <h4 class="fw-semibold">
                            5. Data Sharing
                        </h4>

                        <p class="text-muted">
                            We do not sell personal information.
                            Information may be shared with authorized
                            service providers when necessary to operate
                            the platform or when required by law.
                        </p>
                    </section>

                    @* Your Rights *@
                    <section class="mb-4">
                        <h4 class="fw-semibold">
                            6. Your Rights
                        </h4>

                        <p class="text-muted">
                            Depending on applicable data protection
                            laws, you may have the right to access,
                            correct, or request deletion of your
                            personal information.
                        </p>
                    </section>

                    @* Policy Updates *@
                    <section class="mb-4">
                        <h4 class="fw-semibold">
                            7. Changes to This Policy
                        </h4>

                        <p class="text-muted">
                            This Privacy Policy may be updated when
                            our services or privacy practices change.
                        </p>
                    </section>

                    <hr class="my-4" />

                    <div class="text-center">
                        <p class="text-muted small mb-3">
                            Last updated: October 2026
                        </p>

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-primary rounded-3 px-4">
                            Back to Home
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>