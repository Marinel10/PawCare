@model AppointmentDetailsViewModel
@{
    ViewData["Title"] = "Appointment Details";
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h2 class="fw-bold mb-4">Appointment Details</h2>
                    <dl class="row">
                        <dt class="col-sm-4">Pet</dt>
                        <dd class="col-sm-8">@Model.PetName</dd>
                        <dt class="col-sm-4">Start</dt>
                        <dd class="col-sm-8">@Model.StartTime.ToString("dd.MM.yyyy HH:mm")</dd>
                        <dt class="col-sm-4">End</dt>
                        <dd class="col-sm-8">@Model.EndTime.ToString("dd.MM.yyyy HH:mm")</dd>
                        <dt class="col-sm-4">Created</dt>
                        <dd class="col-sm-8">@Model.CreatedOn.ToString("dd.MM.yyyy HH:mm")</dd>
                        <dt class="col-sm-4">Reason</dt>
                        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Reason) ? "Not specified" : Model.Reason)</dd>
                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">@Model.Status</dd>
                    </dl>
                    <div class="d-flex gap-2 flex-wrap">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
                        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post">
                            <button type="submit" class="btn btn-outline-danger">Cancel Appointment</button>
                        </form>
                        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
