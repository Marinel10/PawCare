@model PetAddInputModel


<div class="pet-create-page">
    <div class="pet-create-card">

        <div class="text-center mb-4">
            <div class="fs-1 mb-2">🐾</div>

            <h2 class="pet-create-title">Add New Pet</h2>

            <p class="pet-create-subtitle">
                Fill in the details to add your furry friend.
            </p>
        </div>

        <form asp-controller="Pets" asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="row g-4">

                <div class="col-md-6">
                    <label asp-for="Name" class="form-label">
                        Pet Name
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="e.g. Luna" />

                    <span asp-validation-for="Name"
                          class="text-danger"></span>
                </div>

               
                <div class="col-md-6">
                    <label asp-for="Gender" class="form-label"></label>

                    <select asp-for="Gender" class="form-select">
                        <option value="">-- Select Gender --</option>
                        <option value="1">Male</option>
                        <option value="2">Female</option>
                    </select>

                    <span asp-validation-for="Gender"
                          class="text-danger"></span>
                </div>

              
                <div class="col-md-6">
                    <label asp-for="BirthDate" class="form-label">
                        Birth Date
                    </label>

                    <input asp-for="BirthDate"
                           type="date"
                           min="1900-01-01"
                           max="@DateTime.Today.ToString("yyyy-MM-dd")"
                           class="form-control" />

                    <span asp-validation-for="BirthDate"
                          class="text-danger"></span>
                </div>

               
                <div class="col-md-6">
                    <label asp-for="PetImageUrl" class="form-label">
                        Pet Image URL
                    </label>

                    <input asp-for="PetImageUrl"
                           class="form-control"
                           placeholder="https://example.com/pet.jpg" />

                    <span asp-validation-for="PetImageUrl"
                          class="text-danger"></span>
                </div>

               
                <div class="col-md-6">
                    <label asp-for="SpeciesId" class="form-label">
                        Species
                    </label>

                    <select asp-for="SpeciesId"
                            asp-items="@(new SelectList(Model.Species, "Id", "Name"))"
                            class="form-select">
                        <option value="">-- Select Species --</option>
                    </select>

                    <span asp-validation-for="SpeciesId"
                          class="text-danger"></span>
                </div>

              
                <div class="col-md-6 d-flex align-items-end">
                    <button type="submit"
                            asp-action="LoadBreeds"
                            formnovalidate
                            class="btn btn-outline-primary w-100">
                        Load Breeds
                    </button>
                </div>

               
                <div class="col-12">
                    <label asp-for="BreedId" class="form-label">
                        Breed <span class="text-muted fw-normal">(Optional)</span>
                    </label>

                    <select asp-for="BreedId"
                            asp-items="@(new SelectList(Model.Breeds, "Id", "Name"))"
                            class="form-select">
                        <option value="">-- Select Breed --</option>
                    </select>

                    <span asp-validation-for="BreedId"
                          class="text-danger"></span>
                </div>

            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-3 flex-wrap">

                <a asp-controller="Pets"
                   asp-action="Index"
                   class="btn btn-light border">
                    Cancel
                </a>

                <button type="submit" class="btn btn-primary">
                    🐾 Add Pet
                </button>

            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}