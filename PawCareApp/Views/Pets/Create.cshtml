@{
    ViewData["Title"] = "Add Pet";
}

<section class="pets-page container py-5">
    <div class="pet-form-card mx-auto">

        <h2 class="fw-bold mb-2">Add New Pet</h2>
        <p class="text-muted mb-4">
            Tell us about your new family member.
        </p>

        <form asp-controller="Pets"
              asp-action="Create"
              method="post">

            <div class="mb-3">
                <label class="form-label">Pet Name</label>
                <input name="Name"
                       class="form-control"
                       placeholder="Enter pet name"
                       required />
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Species</label>
                    <select name="SpeciesId"
                            class="form-select"
                            required>
                        <option value="">Select species</option>
                        <option value="1">Dog</option>
                        <option value="2">Cat</option>
                        <option value="3">Parrot</option>
                        <option value="4">Rabbit</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Breed</label>
                    <select name="BreedId"
                            class="form-select"
                            required>
                        <option value="">Select breed</option>
                        <option value="1">Golden Retriever</option>
                        <option value="2">Beagle</option>
                        <option value="3">British Shorthair</option>
                        <option value="4">Husky</option>
                        <option value="5">Budgerigar</option>
                    </select>
                </div>
            </div>

            <div class="row g-3 mt-1">
                <div class="col-md-6">
                    <label class="form-label">Birth Date</label>
                    <input name="BirthDate"
                           type="date"
                           class="form-control"
                           required />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Gender</label>
                    <select name="Gender" class="form-select">
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </select>
                </div>
            </div>

            <div class="mt-3">
                <label class="form-label">Image URL</label>
                <input name="ImageUrl"
                       type="url"
                       class="form-control"
                       placeholder="https://example.com/pet.jpg" />
            </div>

            <div class="d-flex gap-3 mt-4">
                <button type="submit"
                        class="btn btn-paw flex-fill">
                    <i class="bi bi-check-lg me-2"></i>
                    Save Pet
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary flex-fill">
                    Cancel
                </a>
            </div>

        </form>
    </div>
</section>