@{
    ViewData["Title"] = "My Pets";

    @model IEnumerable<PetViewModel>

}

<section class="pets-page container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">My Pets</h1>
            <p class="text-muted">
                Manage your furry family members.
            </p>
        </div>

        <a asp-controller="Pets"
           asp-action="Create"
           class="btn btn-paw">
            <i class="bi bi-plus-lg me-2"></i>
            Add Pet
        </a>
    </div>

    <div class="row g-4">
        @foreach (var pet in @Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card pet-card h-100">

                    <img src="@pet.PetImageUrl"
                         class="pet-image"
                         alt="@pet.Name" />

                    <div class="card-body d-flex flex-column">
                        <h4 class="fw-bold">@pet.Name</h4>

                        <p class="text-muted mb-2">
                            @pet.SpeciesName · @pet.BreedName
                        </p>

                        <p class="mb-4">
                            <i class="bi bi-calendar-heart me-2"></i>
                            @pet.BirthDate
                        </p>

                        <div class="d-flex gap-2 mt-auto">
                            <a asp-controller="Pets"
                               asp-action="Details"
                               asp-route-id="@pet.Id"
                               class="btn btn-outline-info btn-sm">
                                Details
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@pet.Id"
                               class="btn btn-outline-secondary">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>
</section>