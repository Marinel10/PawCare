@using Microsoft.AspNetCore.Mvc.Rendering
@model EditPetInputModel

@{
    ViewData["Title"] = "Edit Pet";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <div class="fs-1">🐾</div>
                        <h2 class="fw-bold">Edit Pet</h2>
                        <p class="text-muted">
                            Update your pet's information.
                        </p>
                    </div>

                    <form asp-controller="Pets"
                          asp-action="Edit"
                          method="post">

                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="row g-4">

                            @* Name *@
                            <div class="col-md-6">
                                <label asp-for="Name"
                                       class="form-label"></label>

                                <input asp-for="Name"
                                       class="form-control" />

                                <span asp-validation-for="Name"
                                      class="text-danger"></span>
                            </div>

                            @* Gender *@
                            <div class="col-md-6">
                                <label asp-for="Gender"
                                       class="form-label"></label>

                                <select asp-for="Gender"
                                        class="form-select">
                                    <option value="">-- Select Gender --</option>
                                    <option value="1">Male</option>
                                    <option value="2">Female</option>
                                </select>

                                <span asp-validation-for="Gender"
                                      class="text-danger"></span>
                            </div>

                            @* Birth Date *@
                            <div class="col-md-6">
                                <label asp-for="BirthDate"
                                       class="form-label"></label>

                                <input asp-for="BirthDate"
                                       type="date"
                                       min="1900-01-01"
                                       max="@DateTime.Today.ToString("yyyy-MM-dd")"
                                       class="form-control" />

                                <span asp-validation-for="BirthDate"
                                      class="text-danger"></span>
                            </div>

                            @* Image URL *@
                            <div class="col-md-6">
                                <label asp-for="PetImageUrl"
                                       class="form-label"></label>

                                <input asp-for="PetImageUrl"
                                       class="form-control" />

                                <span asp-validation-for="PetImageUrl"
                                      class="text-danger"></span>
                            </div>

                            @* Species *@
                            <div class="col-md-6">
                                <label asp-for="SpeciesId"
                                       class="form-label"></label>

                                <select asp-for="SpeciesId"
                                        asp-items="@(new SelectList(Model.Species, "Id", "Name"))"
                                        class="form-select">
                                    <option value="">-- Select Species --</option>
                                </select>

                                <span asp-validation-for="SpeciesId"
                                      class="text-danger"></span>
                            </div>

                            @* Breed *@
                            <div class="col-md-6">
                                <label asp-for="BreedId"
                                       class="form-label">
                                    Breed (Optional)
                                </label>

                                <select asp-for="BreedId"
                                        asp-items="@(new SelectList(Model.Breeds, "Id", "Name"))"
                                        class="form-select">
                                    <option value="">-- Select Breed --</option>
                                </select>

                                <span asp-validation-for="BreedId"
                                      class="text-danger"></span>
                            </div>

                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-3">
                            <a asp-controller="Pets"
                               asp-action="Index"
                               class="btn btn-light border">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-primary px-4">
                                Save Changes
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
